# ==============================================================================
# RuntimeRoasters — Root Environment Configuration
# ==============================================================================
# Mục đích: Chứa các tham số cấu hình CHUNG cho toàn bộ hệ thống.
# Mỗi service có thể có file .env riêng để ghi đè các tham số này.
# COPY file này thành .env trước khi bắt đầu.
# ==============================================================================

# --- [1] Infrastructure Ports ---
# Các cổng kết nối tới các dịch vụ hạ tầng (Docker)
POSTGRES_PORT=54321
VALKEY_PORT=6379
KAFKA_PORT=9094
KAFKA_UI_PORT=8090
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
CASSANDRA_PORT=9042

# --- [2] Identity & Security ---
# INTERNAL_SECRET: Dùng để các dịch vụ nội bộ (Internal Services) nhận diện nhau.
# Quan trọng: Trong production phải là một chuỗi ngẫu nhiên dài ít nhất 32 ký tự.
INTERNAL_SECRET=68f59c82c34424dbd0853a6cf159047be593d4e98d766db7e5047ec9ead3c71c

# Identity Service URLs (Ory Kratos & Hydra)
KRATOS_PUBLIC_URL=http://localhost:4433
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445
# IDENTITY_PROXY_URL: Nginx proxy bảo vệ endpoint JWKS của Hydra
IDENTITY_PROXY_URL=http://localhost:4434 

# --- [3] API Gateway ---
# KrakenD Gateway là điểm tiếp nhận duy nhất cho Client App
GATEWAY_URL=http://localhost:8081

# --- [4] Service Ports Mapping (For Reference) ---
# Danh sách các cổng mặc định của các microservices (để tiện tra cứu)
# | Service       | REST Port | gRPC Port |
# |---------------|-----------|-----------|
# | Auth          | 8082      | 50052     |
# | Farm          | 8083      | 50053     |
# | Retail        | 8084      | 50054     |
# | Warehouse     | 8085      | 50055     |
# | Logistics     | 8087      | 50057     |
# | Payment       | 8088      | 50058     |
# | Trace         | 8089      | 50059     |
# | Audit         | 8091      | 50061     |

# --- [5] Database Connections ---
# DSN (Data Source Name) cho các services
# Lưu ý: Mỗi service kết nối tới DB riêng trong cùng 1 cụm Postgres
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_SSLMODE=disable
