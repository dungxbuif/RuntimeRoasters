# Auth Service Configuration
APP_NAME=auth-service
APP_ENV=development
APP_PORT=8082
GRPC_PORT=50052
LOG_LEVEL=debug
DB_LOG_LEVEL=warn
INTERNAL_HOST=127.0.0.1

# PostgreSQL (Specific DB for Auth Service)
DATABASE_URL=postgres://user:password@localhost:54321/auth_db?sslmode=disable

# Redis (for Blacklist)
VALKEY_ADDR=localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_AUTH_TOPIC=auth.user.events
KAFKA_AUTH_POLICY_TOPIC=auth.policy.changed

# Ory Kratos Admin
KRATOS_ADMIN_URL=http://localhost:4434
HYDRA_ADMIN_URL=http://localhost:4445

# Security
INTERNAL_SECRET=68f59c82c34424dbd0853a6cf159047be593d4e98d766db7e5047ec9ead3c71c
JWKS_URL=http://localhost:4434/.well-known/jwks.json
JWKS_CACHE_TTL=1h
EXPECTED_ISSUER=http://localhost:4444/

# Seeding Propagation URLs
FARM_SERVICE_URL=http://localhost:8083
RETAIL_SERVICE_URL=http://localhost:8084
LOGISTICS_SERVICE_URL=http://localhost:8085
WAREHOUSE_SERVICE_URL=http://localhost:8089
