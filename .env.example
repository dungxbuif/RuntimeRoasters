# === RuntimeRoasters — Environment Variables ===
# Copy this file to .env and adjust values for your local setup.

# --- Application ---
APP_NAME=demo-service
APP_ENV=development          # "development" | "production"
APP_PORT=8080
GRPC_PORT=50051
LOG_LEVEL=debug              # "debug" | "info" | "warn" | "error"

# --- PostgreSQL ---
DATABASE_URL=postgres://user:password@localhost:5432/demo_db?sslmode=disable

# --- Redis (Redis-compatible) ---
REDIS_ADDR=localhost:6379

# --- Identity (Ory Kratos & Hydra) ---
NEXT_PUBLIC_KRATOS_PUBLIC_URL=http://localhost:4433
NEXT_PUBLIC_HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445
INTERNAL_SECRET=dev-secret-change-in-production

# --- Frontend & Gateway ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8081
NEXT_PUBLIC_OIDC_CLIENT_ID=client-app
OIDC_CLIENT_SECRET=client-secret

# --- Observability & Docs ---
NEXT_PUBLIC_JAEGER_URL=http://localhost:16686
NEXT_PUBLIC_SWAGGER_JSON_URL=http://localhost:8081/swagger/demo.swagger.json
