{
  "version": 3,
  "name": "RuntimeRoasters Gateway",
  "port": 8081,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:3000"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [
        "Content-Length"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    },
    "telemetry/opentelemetry": {
      "service_name": "krakend",
      "exporters": {
        "otlp": [
          {
            "host": "jaeger",
            "port": 4317
          }
        ]
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/demo/ping",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://identity:4434/.well-known/jwks.json",
          "roles_key": "scope",
          "roles": ["demo:read"],
          "issuer": "http://localhost:4444/"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/demo/ping",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": [
            "http://host.docker.internal:8080"
          ],
          "disable_host_sanitize": true
        }
      ]
    },
    {
      "endpoint": "/v1/farms",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://identity:4434/.well-known/jwks.json",
          "roles_key": "scope",
          "roles": ["farm:admin"],
          "issuer": "http://localhost:4444/"
        }
      },
      "backend": [
        {
          "url_pattern": "/v1/farms",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": [
            "http://host.docker.internal:8083"
          ],
          "disable_host_sanitize": true
        }
      ]
    },
    {
      "endpoint": "/v1/admin/users",
      "method": "GET",
