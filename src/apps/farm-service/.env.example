APP_NAME=farm-service
APP_ENV=development
LOG_LEVEL=info
DB_LOG_LEVEL=warn
APP_PORT=8083
GRPC_PORT=50053
INTERNAL_HOST=127.0.0.1

# PostgreSQL (Direct access via mapped port 54321)
DATABASE_URL=postgres://user:password@localhost:54321/farm_db?sslmode=disable
VALKEY_ADDR=localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_HARVEST_TOPIC=farm.harvest.created
KAFKA_AUTH_POLICY_TOPIC=auth.policy.changed

# Auth Integration
AUTH_SERVICE_ADDR=localhost:50052
