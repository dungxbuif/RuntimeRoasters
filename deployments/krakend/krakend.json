{
  "version": 3,
  "name": "RuntimeRoasters Gateway",
  "port": 8081,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["http://localhost:3000", "http://127.0.0.1:3000"],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Accept"],
      "expose_headers": ["Content-Length"],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/auth/login/accept",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/v1/auth/login/accept",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://host.docker.internal:8082"],
          "disable_host_sanitize": true
        }
      ]
    },
    {
      "endpoint": "/v1/users",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/v1/users",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": ["http://host.docker.internal:8082"],
          "disable_host_sanitize": true
        }
      ]
    },
    {
      "endpoint": "/v1/users",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "url_pattern": "/v1/users",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://host.docker.internal:8082"],
          "disable_host_sanitize": true
        }
      ]
    },
    {
      "endpoint": "/v1/farms",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["*"],
      "backend": [
        {
          "url_pattern": "/v1/farms",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": ["http://host.docker.internal:8083"],
          "disable_host_sanitize": true
        }
      ]
    },
    {
      "endpoint": "/v1/farms",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Authorization", "Content-Type"],
      "backend": [
        {
          "url_pattern": "/v1/farms",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://host.docker.internal:8083"],
          "disable_host_sanitize": true
        }
      ]
    }
  ]
}
