{
  "version": 3,
  "name": "RuntimeRoasters Gateway",
  "port": 8081,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:3000"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "allow_headers": [
        "Origin",
        "Authorization",
        "Content-Type"
      ],
      "expose_headers": [
        "Content-Length"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/auth/login/accept",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50052"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.auth.v1.AuthService",
              "method": "AcceptLogin"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/users",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50052"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.auth.v1.AuthService",
              "method": "ListUsers"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/users",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50052"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.auth.v1.AuthService",
              "method": "CreateUser"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/farms",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50053"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.farm.v1.FarmService",
              "method": "ListFarms"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/farms",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50053"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.farm.v1.FarmService",
              "method": "CreateFarm"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/farms/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50053"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.farm.v1.FarmService",
              "method": "GetFarm"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/farms/{id}",
      "method": "PUT",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50053"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.farm.v1.FarmService",
              "method": "UpdateFarm"
            }
          }
        }
      ]
    },
    {
      "endpoint": "/v1/farms/{id}",
      "method": "DELETE",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization"
      ],
      "backend": [
        {
          "encoding": "grpc",
          "sd": "static",
          "host": [
            "host.docker.internal:50053"
          ],
          "disable_host_sanitize": true,
          "extra_config": {
            "backend/grpc": {
              "service": "runtime.farm.v1.FarmService",
              "method": "DeleteFarm"
            }
          }
        }
      ]
    }
  ]
}
