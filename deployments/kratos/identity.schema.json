{
  "$id": "https://schemas.ory.sh/presets/kratos/identity.email.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeRoasters Identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "recovery": {
              "via": "email"
            },
            "verification": {
              "via": "email"
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Full Name"
        },
        "role": {
          "type": "string",
          "title": "User Role",
          "description": "e.g. ADMIN, FARM_ADMIN, FARM_MANAGER, FARMER, PROCESSOR, WAREHOUSE_MGR, DRIVER, STORE_MGR, GUEST",
          "default": "GUEST",
          "enum": ["ADMIN", "FARM_ADMIN", "FARM_MANAGER", "FARMER", "PROCESSOR", "WAREHOUSE_MGR", "DRIVER", "STORE_MGR", "GUEST"]
        },
        "org_id": {
          "type": "string",
          "title": "Organization ID",
          "description": "UUID of the organization this user belongs to"
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
