# === RuntimeRoasters — Environment Variables ===
# Copy this file to .env and adjust values for your local setup.

# --- Application ---
APP_NAME=farm-service
APP_ENV=development          # "development" | "production"
APP_PORT=8080
GRPC_PORT=50051
LOG_LEVEL=debug              # "debug" | "info" | "warn" | "error"

# --- PostgreSQL ---
DATABASE_URL=postgres://user:password@localhost:5432/farm_db?sslmode=disable

# --- Redis (Redis-compatible) ---
REDIS_ADDR=localhost:6379
