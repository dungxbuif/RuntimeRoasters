APP_NAME=socket-service
APP_ENV=development
APP_PORT=8091
GRPC_PORT=50060
LOG_LEVEL=info
VALKEY_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9094
KAFKA_GROUP_ID=socket-service-group
KAFKA_SOCKET_BROADCAST_TOPIC=socket.broadcast.requested
SOCKET_SESSION_TTL=90s
SOCKET_INTERNAL_API_KEYS=
INTERNAL_SECRET=dev-internal-secret
JWKS_URL=http://localhost:4444/.well-known/jwks.json
JWKS_CACHE_TTL=5m
EXPECTED_ISSUER=http://localhost:4444/
AUTH_SERVICE_ADDR=localhost:50052
KAFKA_AUTH_POLICY_TOPIC=auth.policy.changed
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
