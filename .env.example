# === RuntimeRoasters — Root Environment Configuration ===
# Mục đích: Chứa các tham số CHUNG cho toàn bộ hệ thống.
# Mỗi service sẽ có file .env riêng ghi đè các tham số này nếu cần.

# --- Global Infrastructure ---
POSTGRES_PORT=54321
VALKEY_PORT=6379
KAFKA_PORT=9094
KAFKA_UI_PORT=8090

# --- Shared Secrets ---
# Dùng để các internal service nhận diện nhau khi gọi JWKS Gatekeeper
INTERNAL_SECRET=dev-secret-change-in-production

# --- Identity Services ---
KRATOS_PUBLIC_URL=http://localhost:4433
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445
IDENTITY_PROXY_URL=http://localhost:4434 # Dùng để tải JWKS

# --- Global Gateway ---
GATEWAY_URL=http://localhost:8081

# --- Service Ports Mapping (For Reference) ---
# Auth: 8082 / 50052
# Farm: 8083 / 50053
# Process: 8084 / 50054
# Warehouse: 8085 / 50055
# Retail: 8086 / 50056
# Logistics: 8087 / 50057
# Payment: 8088 / 50058
# Trace: 8089 / 50059
# Audit: 8091 / 50061
# Webhook: 8092 / 50062
agger/demo.swagger.json
